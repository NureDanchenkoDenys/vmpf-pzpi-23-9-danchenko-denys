<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="20dp"
    android:paddingTop="45dp"
    android:background="#F4F6F8">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Деталі задачі"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/detailsTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Назва задачі"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/detailsDescriptionTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Опис задачі"
        android:textSize="18sp"
        android:textColor="#374151"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/detailsStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Статус: не виконано"
        android:textSize="18sp"
        android:textColor="#1F2937"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Повернутися назад" />

</LinearLayout>